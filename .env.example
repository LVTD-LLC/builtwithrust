# --- Server ---
BIND_ADDR=0.0.0.0:3000
SITE_URL=http://localhost:3000
DATABASE_URL=sqlite://data/builtwithrust.db?mode=rwc
RUST_LOG=builtwithrust=info,tower_http=info

# --- Admin API (required for /api/admin/*; generate with: openssl rand -hex 32) ---
ADMIN_TOKEN=

# --- PostHog (project "Built with Rust", id 639107) ---
POSTHOG_KEY=phc_nSst8QaFAtfJNm28UUppXvM68ESUUBV4BSQuz6TvsXVN
POSTHOG_HOST=https://us.i.posthog.com

# --- Stripe (leave blank to disable payments; set all three to enable) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Days a paid "featured" slot lasts
FEATURE_DAYS=30

# Optional double-opt-in newsletter; both values enable the signup form.
# Private Listmonk origin + public list UUID only, never admin credentials.
NEWSLETTER_LISTMONK_URL=
NEWSLETTER_LIST_UUID=
