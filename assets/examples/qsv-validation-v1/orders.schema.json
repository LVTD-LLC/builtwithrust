{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "hold"
      ]
    }
  },
  "required": [
    "order_id",
    "quantity",
    "status"
  ],
  "additionalProperties": false
}
