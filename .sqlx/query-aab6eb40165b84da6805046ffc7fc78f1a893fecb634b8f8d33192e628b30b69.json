  "query": "SELECT c.id AS \"id!\", c.slug AS \"slug!\", c.name AS \"name!\",\n                  COUNT(p.id) AS \"count!: i64\"\n           FROM categories c\n           LEFT JOIN projects p ON p.category_id = c.id AND p.published = 1\n           GROUP BY c.id\n           HAVING COUNT(p.id) > 0\n           ORDER BY c.name",
